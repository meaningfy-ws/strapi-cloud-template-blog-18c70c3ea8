{
  "kind": "collectionType",
  "collectionName": "route_frequencies",
  "info": {
    "singularName": "route-frequency",
    "pluralName": "route-frequencies",
    "displayName": "Route Frequency",
    "description": "Admin-managed lookup of schedule frequency values — extensible without code changes"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
