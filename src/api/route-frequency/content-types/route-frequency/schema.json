      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "label",
      "required": true
    },
    "description": {
      "type": "text",
      "required": false
    },
    "schedules": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::route-schedule.route-schedule",
      "mappedBy": "frequency"
    }
  }
}
